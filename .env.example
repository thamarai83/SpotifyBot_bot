# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval
VECTOR_RESULTS=5
KEYWORD_RESULTS=5
RRF_K=60
RERANK_RESULTS=3

# Paths
UPLOAD_DIR=data/uploads
INDEX_DIR=data/indexes
